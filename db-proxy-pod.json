{
  "spec": {
    "containers": [
      {
        "name": "db-proxy",
        "image": "alpine/socat",
        "command": ["sh", "-c", "socat TCP-LISTEN:3306,fork,reuseaddr TCP:$(DB_HOST):3306"],
        "envFrom": [
          { "configMapRef": { "name": "ecommerce-config" } }
        ]
      }
    ]
  }
}